#!/bin/sh
# ingeniero-agentico · pre-push
# For every commit being pushed, exports that exact tree (git archive) to a temporary folder and runs
#   security/scan.py   (full scan, private denylist included when available) and
#   security/manifest.py verify   (every distributable file matches security/MANIFEST.sha256)
# Blocks the push on any HIGH finding or any manifest mismatch.
# Enable once per clone:  git config core.hooksPath .githooks

ROOT=$(git rev-parse --show-toplevel) || exit 1
ZERO=0000000000000000000000000000000000000000

find_python() {
    for cand in "py -3" python3 python; do
        # shellcheck disable=SC2086
        if $cand -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
            echo "$cand"
            return 0
        fi
    done
    return 1
}

PY=$(find_python) || {
    echo "pre-push: Python 3.11+ not found (tried py -3, python3, python); push blocked." >&2
    exit 1
}

DENY=""
if [ -n "$INGENIERO_DATOS" ] && [ -f "$INGENIERO_DATOS/security/denylist.txt" ]; then
    DENY="$INGENIERO_DATOS/security/denylist.txt"
elif [ -f "$ROOT/../ingeniero-agentico-datos/security/denylist.txt" ]; then
    DENY="$ROOT/../ingeniero-agentico-datos/security/denylist.txt"
fi

failed=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$ZERO" ] && continue   # deleting a remote branch: nothing to scan
    tmp=$(mktemp -d 2>/dev/null || mktemp -d -t ia-prepush)
    if ! git -C "$ROOT" archive --format=tar "$local_sha" | tar -xf - -C "$tmp"; then
        echo "pre-push: could not export $local_sha; push blocked." >&2
        rm -rf "$tmp"
        exit 1
    fi
    echo "pre-push: checking $local_ref ($(echo "$local_sha" | cut -c1-12))"
    # The scanner and manifest checker come from the working tree you trust, not from the pushed tree.
    if [ -n "$DENY" ]; then
        # shellcheck disable=SC2086
        $PY "$ROOT/security/scan.py" --root "$tmp" --all-files --denylist "$DENY" --hook || failed=1
    else
        echo "pre-push: private denylist not found; scanning with generic patterns only." >&2
        # shellcheck disable=SC2086
        $PY "$ROOT/security/scan.py" --root "$tmp" --all-files --no-denylist --hook || failed=1
    fi
    # shellcheck disable=SC2086
    $PY "$ROOT/security/manifest.py" verify --root "$tmp" || failed=1
    rm -rf "$tmp"
done

if [ "$failed" -ne 0 ]; then
    echo "pre-push: blocked. Fix the findings above (or regenerate the manifest if the change is yours)." >&2
    exit 1
fi
exit 0
