{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "allow": [],
    "ask": [
      "Edit",
      "Write",
      "mcp__*"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(rd *)",
      "Bash(erase *)",
      "Bash(unlink *)",
      "Bash(shred *)",
      "Bash(find * -delete*)",
      "Bash(git clean *)",
      "Bash(git rm *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Clear-Content *)",
      "PowerShell(Clear-RecycleBin *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(ftp *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(curl *)",
      "PowerShell(curl.exe *)",
      "PowerShell(wget *)",
      "PowerShell(Start-BitsTransfer *)",
      "PowerShell(Send-MailMessage *)",
      "WebFetch",
      "WebSearch",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(py -m pip install *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(winget *)",
      "Bash(choco *)",
      "Bash(msiexec *)",
      "Bash(brew install *)",
      "Bash(apt install *)",
      "Bash(apt-get install *)",
      "Bash(sudo *)",
      "PowerShell(pip install *)",
      "PowerShell(py -m pip install *)",
      "PowerShell(npm install *)",
      "PowerShell(winget *)",
      "PowerShell(choco *)",
      "PowerShell(msiexec *)",
      "PowerShell(Install-Module *)",
      "PowerShell(Install-Package *)",
      "Bash(git push *)",
      "PowerShell(git push *)"
    ]
  }
}
